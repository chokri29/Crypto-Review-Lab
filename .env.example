# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# COINGECKO_API_KEY: Optional API key for CoinGecko live market data proxy & MCP server.
COINGECKO_API_KEY=""

# CMC_API_KEY: Optional server-side API key for CoinMarketCap Pro Real-World Assets (RWA) API.
CMC_API_KEY=""

# ADMIN_PASSPHRASE_HASH: Required bcrypt hash of the admin passphrase for /api/admin/login authentication.
# Generate once:
# node -e "console.log(require('bcryptjs').hashSync('your-passphrase', 12))"
ADMIN_PASSPHRASE_HASH=""

# ADMIN_MASTER_KEY: Admin Master Key required for /api/admin/login authentication.
# (or ADMIN_MASTER_KEYS=key1,key2)
ADMIN_MASTER_KEY=""

# GOPLUS_APP_KEY & GOPLUS_APP_SECRET: Authenticated API credentials for GoPlus Token Security.
# Generates authenticated Bearer access tokens on server-side.
GOPLUS_APP_KEY=""
GOPLUS_APP_SECRET=""

# RUGCHECK_API_KEY: Authenticated API key for Solana token security scanning via RugCheck.
RUGCHECK_API_KEY=""

# BLOCKSCOUT_API_KEY: Authenticated API key for EVM token corroboration (metadata & holder concentration).
BLOCKSCOUT_API_KEY=""

# NOWPAYMENTS_IPN_SECRET: Server-side secret key used to verify HMAC-SHA512 signatures on NOWPayments IPN callbacks.
# Found in NOWPayments Dashboard -> Payment Settings / Store Settings -> IPN Secret. Server-side only.
NOWPAYMENTS_IPN_SECRET=""

# NOWPAYMENTS_API_KEY: Optional server-side API key for dynamic invoice generation via NOWPayments API.
NOWPAYMENTS_API_KEY=""

# Cloud SQL / PostgreSQL Database Configuration
# Runtime application connection credentials (used by src/db/index.ts)
SQL_HOST="127.0.0.1"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_DB_NAME="cryptoreviewlab"

# Migration and administrative credentials with DDL privileges (used by drizzle.config.ts)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

